[
 {
  "tag": "01_01",
  "sec": "01",
  "text": "先看一个大标题场景，*核心词* 落在中间那句后面。",
  "pause": 0.4,
  "dur": 4.0,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.25,
  "pk_db": 0
 },
 {
  "tag": "01_02",
  "sec": "01",
  "text": "这一段用来看排版是不是左对齐、底线是不是跟文字一样宽。",
  "pause": 0.5,
  "dur": 5.02,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.98,
  "pk_db": 0
 },
 {
  "tag": "01_03",
  "sec": "01",
  "text": "最后一句把关键词说完，画面就在这句定格。",
  "pause": 0.5,
  "dur": 3.42,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.26,
  "pk_db": 0
 },
 {
  "tag": "02_04",
  "sec": "02",
  "text": "要点列表是最常见的版式，*三个要点* 依次出现。",
  "pause": 0.4,
  "dur": 3.94,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.08,
  "pk_db": 0
 },
 {
  "tag": "02_05",
  "sec": "02",
  "text": "第一项在进场时就位，第二项跟着来，第三项是关键词。",
  "pause": 0.5,
  "dur": 4.68,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.7,
  "pk_db": 0
 },
 {
  "tag": "02_06",
  "sec": "02",
  "text": "排成三行还是三栏，取决于画幅方向。",
  "pause": 0.5,
  "dur": 3.3,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.55,
  "pk_db": 0
 },
 {
  "tag": "03_07",
  "sec": "03",
  "text": "步骤流程跟要点类似，但顺序更重要，*四个步骤* 排成一列。",
  "pause": 0.4,
  "dur": 5.04,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.76,
  "pk_db": 0
 },
 {
  "tag": "03_08",
  "sec": "03",
  "text": "每一项有编号，编号和文字要对齐到同一条基线。",
  "pause": 0.5,
  "dur": 4.26,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.69,
  "pk_db": 0
 },
 {
  "tag": "03_09",
  "sec": "03",
  "text": "最后一步在关键词那一刻落定。",
  "pause": 0.5,
  "dur": 2.3,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.65,
  "pk_db": 0
 },
 {
  "tag": "04_10",
  "sec": "04",
  "text": "左右对比适合放两种做法，*两种做法* 摆在一起。",
  "pause": 0.4,
  "dur": 4.58,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.37,
  "pk_db": 0
 },
 {
  "tag": "04_11",
  "sec": "04",
  "text": "左边是旧方案，右边是新方案，颜色区分。",
  "pause": 0.5,
  "dur": 3.72,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.3,
  "pk_db": 0
 },
 {
  "tag": "04_12",
  "sec": "04",
  "text": "关键词说出的那一刻，右边那块要亮起来。",
  "pause": 0.5,
  "dur": 3.0,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.67,
  "pk_db": 0
 },
 {
  "tag": "05_13",
  "sec": "05",
  "text": "大数字是最有冲击力的版式，*百分之百* 是目标值。",
  "pause": 0.4,
  "dur": 4.2,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.0,
  "pk_db": 0
 },
 {
  "tag": "05_14",
  "sec": "05",
  "text": "数字从七成开始滚，滚到目标值停住。",
  "pause": 0.5,
  "dur": 3.5,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.29,
  "pk_db": 0
 },
 {
  "tag": "05_15",
  "sec": "05",
  "text": "底线在数字下方扫出来。",
  "pause": 0.5,
  "dur": 1.84,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.43,
  "pk_db": 0
 },
 {
  "tag": "06_16",
  "sec": "06",
  "text": "引用别人的话要用不同的处理，*这句话* 很重要。",
  "pause": 0.4,
  "dur": 4.42,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.52,
  "pk_db": 0
 },
 {
  "tag": "06_17",
  "sec": "06",
  "text": "引号在左边距，正文从第一栏开始，署名右对齐。",
  "pause": 0.5,
  "dur": 4.44,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.28,
  "pk_db": 0
 },
 {
  "tag": "06_18",
  "sec": "06",
  "text": "整块从左侧滑进来，落在关键词那一刻。",
  "pause": 0.5,
  "dur": 3.16,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.06,
  "pk_db": 0
 },
 {
  "tag": "07_19",
  "sec": "07",
  "text": "改前改后适合做对比，*差别* 一眼能看出来。",
  "pause": 0.4,
  "dur": 3.94,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.57,
  "pk_db": 0
 },
 {
  "tag": "07_20",
  "sec": "07",
  "text": "上面是旧样子，下面是新样子，中间一条分割线。",
  "pause": 0.5,
  "dur": 3.86,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.92,
  "pk_db": 0
 },
 {
  "tag": "07_21",
  "sec": "07",
  "text": "新样子在关键词那一刻从下方推上来。",
  "pause": 0.5,
  "dur": 3.24,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.94,
  "pk_db": 0
 },
 {
  "tag": "08_22",
  "sec": "08",
  "text": "清单式适合列要点，*四条* 依次打勾。",
  "pause": 0.4,
  "dur": 3.58,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.19,
  "pk_db": 0
 },
 {
  "tag": "08_23",
  "sec": "08",
  "text": "每一条左边有一个圆圈，里面是勾。",
  "pause": 0.5,
  "dur": 2.66,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.26,
  "pk_db": 0
 },
 {
  "tag": "08_24",
  "sec": "08",
  "text": "最后一条在关键词那一刻左移到位。",
  "pause": 0.5,
  "dur": 2.96,
  "round": 0,
  "overlap": 1.0,
  "cps": 5.07,
  "pk_db": 0
 },
 {
  "tag": "09_25",
  "sec": "09",
  "text": "产品展示要有名字和特性，*三个特性* 列在右边。",
  "pause": 0.4,
  "dur": 4.28,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.67,
  "pk_db": 0
 },
 {
  "tag": "09_26",
  "sec": "09",
  "text": "名字是大字，特性是小字，右边一列。",
  "pause": 0.5,
  "dur": 3.5,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.0,
  "pk_db": 0
 },
 {
  "tag": "09_27",
  "sec": "09",
  "text": "名字从下方升起来，底线跟着展开。",
  "pause": 0.5,
  "dur": 3.0,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.67,
  "pk_db": 0
 },
 {
  "tag": "10_28",
  "sec": "10",
  "text": "结尾要有个行动号召，*收藏下来* 下次再看。",
  "pause": 0.4,
  "dur": 3.76,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.79,
  "pk_db": 0
 },
 {
  "tag": "10_29",
  "sec": "10",
  "text": "主标题大字，副标题小字，按钮在最下面。",
  "pause": 0.5,
  "dur": 3.7,
  "round": 0,
  "overlap": 1.0,
  "cps": 4.32,
  "pk_db": 0
 },
 {
  "tag": "10_30",
  "sec": "10",
  "text": "主标题在关键词那一刻升起来。",
  "pause": 1.0,
  "dur": 2.14,
  "round": 0,
  "overlap": 1.0,
  "cps": 6.07,
  "pk_db": 0
 }
]